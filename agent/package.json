    "playwright": "^1.65.1",
    "suncalc": "^2.1.4",
    "tsx": "^4.20.6",
    "web-push": "^4.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.10.1",
