{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pips.world/blueprint.schema.json",
  "title": "Pip blueprint",
  "description": "JSON data for one object. Primitives only. No code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["primitives"],
  "properties": {
    "primitives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/primitive" }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": { "type": "number", "minimum": -8, "maximum": 12 },
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,20}$" }
    },
    "behaviour": { "enum": ["sway", "follow_path"] }
  },
  "$defs": {
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "size", "position", "rotation", "colour"],
      "properties": {
        "shape": { "enum": ["box", "cylinder", "cone", "sphere"] },
        "size": { "$ref": "#/$defs/triple" },
        "position": { "$ref": "#/$defs/triple" },
        "rotation": { "$ref": "#/$defs/triple" },
        "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "foliage": { "type": "boolean" },
        "emissive": { "type": "boolean" },
        "layer": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "triple": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    }
  }
}
