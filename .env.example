# Copy to .env. Lines marked "secret" must stay empty here.
# An empty value below means "use the built-in default".

PORT=3001

# npm start sets NODE_ENV=production. Railway sets it too. Leave it unset locally.

# secret. Required for npm start and for Railway. At least 8 characters.
# Empty leaves local npm run dev open, and production refuses to start.
OWNER_PASSWORD=

# Empty keeps the database in data/, and memory and published next to the code.
# On Railway set this to the volume mount, usually /data.
DATA_DIR=

# secret
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
# Empty uses LLM_MODEL. Set a stronger model here for the evening reflection, the Sunday reflection, and the daily digest only.
LLM_MODEL_REFLECT=

# 1 or true runs the fake event emitter. Empty runs the real clock.
DEMO_MODE=

# Simulator delay in milliseconds. Used only while DEMO_MODE is on. Empty uses 8000.
TICK_MS=

# Minutes between ticks, read once at startup. Empty uses 30, which fires at :00 and :30
# in OWNER_TIMEZONE. Must divide 60 (1, 2, 3, 4, 5, 6, 10, 12, 15, 20, 30, or 60).
TICK_INTERVAL_MINUTES=30

# Approved plot expansions in a rolling week. Empty uses 1. Read once at startup.
EXPANSION_PER_WEEK=1
# Most unlocked plots, including the starting village. Empty uses 16. Read once at startup.
MAX_PLOTS=16

# Awake window, village local time, read once at startup. End is exclusive.
# 07:00 and 23:00 means the last tick is 22:30. 00:00 and 24:00 runs all day.
AWAKE_START=07:00
AWAKE_END=23:00

# Days follow the village clock and DAY_START_HOUR. TICKS_PER_DAY is not the day length.
TICKS_PER_DAY=

# Empty uses 48 ticks, 500 calls, and 500000 tokens.
DAILY_TICK_CAP=
DAILY_CALL_CAP=
DAILY_TOKEN_CAP=

# Empty leaves chat on. Set to 0 to turn chat off.
CHAT_ENABLED=
# Empty uses 100 chats a day.
DAILY_CHAT_CAP=
# A blank number becomes 0, so this stays commented. Uncomment to override the 10 minute idle wait.
# CHAT_IDLE_MS=600000

SEARCH_API=tavily
# secret
SEARCH_API_KEY=
# Empty uses 10 web calls a tick and 30 searches a day. Searches stay capped for Tavily.
WEB_CALLS_PER_TICK=
DAILY_SEARCH_CAP=
# Empty uses 200 page reads a day. Read once at startup.
DAILY_READ_CAP=
# Empty uses 3 builds a day.
DAILY_BUILD_CAP=
# Empty uses 6000 words, a 10 second timeout, and a 5 MB image limit.
READ_PAGE_WORDS=
READ_TIMEOUT_MS=
VIEW_IMAGE_MAX_BYTES=

NTFY_SERVER=https://ntfy.sh
# secret. Topic name or the full ntfy link. Empty skips the push.
NTFY_TOPIC=
# Empty links the notification at http://localhost:5173
WORLD_URL=

# secret. Web push signing key. Empty leaves web push off. ntfy still works.
VAPID_PUBLIC_KEY=
# secret
VAPID_PRIVATE_KEY=
# Contact shown to the push service. Empty uses mailto:owner@pips.world
VAPID_SUBJECT=mailto:owner@pips.world

# Not read yet. Reserved so a Telegram notifier can be added later.
# secret
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# real uses the date in OWNER_TIMEZONE. accelerated is the debug switch and steps the season every SEASON_LENGTH_DAYS. Daylight still follows the real sun.
SEASON_MODE=real
# south: summer Dec–Feb. north: summer Jun–Aug.
SEASON_HEMISPHERE=south
# Empty uses 3 days.
SEASON_LENGTH_DAYS=

# IANA name for Pip's clock. Empty uses Australia/Melbourne.
OWNER_TIMEZONE=Australia/Melbourne
# Empty uses Melbourne: -37.8136, 144.9631.
WORLD_LAT=-37.8136
WORLD_LON=144.9631
# Local hour when a new day starts. Hours before this belong to the previous day. Empty uses 4.
DAY_START_HOUR=4
# Local hour to send the daily digest, and Sunday's weekly reflection. Empty uses 20.
DIGEST_HOUR=20
# Storage for Pip's creations. Empty uses 2048 MB. Read once at startup.
STORAGE_BUDGET_MB=
# 1 or true requires the owner to approve a blueprint before it goes live. Empty means off.
BLUEPRINT_APPROVAL=
# 1 or true serves the public creations page. Empty means off.
CREATIONS_PUBLIC=
# Notification kinds. Empty means on. Set 0 to turn one off. Read once at startup.
ALERT_DIGEST=
ALERT_REQUEST=
ALERT_PROJECT=
ALERT_QUIET=
# Largest single creation, all versions together. Empty uses 32 MB.
CREATION_MAX_MB=
# Public overview page. Off hides it. A later public view can omit chat, requests, budget and settings.
PUBLIC_OVERVIEW=
# Dollars per million tokens, used only to estimate today's spend on the Overview. Empty uses 0.10.
USD_PER_MILLION_TOKENS=
